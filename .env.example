# Hello Crew settings. Copy to .env (never commit .env) and fill in the blanks.
#   Local:       cp .env.example .env
#   Production:  cp .env.example deploy/production.env   (see docs/DEPLOYMENT.md)
# Both `docker compose` and `npm start` read .env.
# Copyright (c) 2026 PacificAI. All rights reserved.

# ---------------------------------------------------------------- Access
# Code(s) needed to create an account, comma-separated. Set before sharing a link.
INVITE_CODE=

# Admin panel (http://localhost:3001). Password: 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Database
POSTGRES_USER=hellocrew
# Use letters and digits only (it goes into a connection URL).
POSTGRES_PASSWORD=
POSTGRES_DB=hellocrew
# Host port for local DB tools (bound to 127.0.0.1). 5433 avoids clashing with another Postgres.
POSTGRES_PORT=5433
# Only for running `npm start` / `npm run admin` outside Docker:
DATABASE_URL=postgres://hellocrew:CHANGE_ME@127.0.0.1:5433/hellocrew

# ---------------------------------------------------------------- Ports (bound to 127.0.0.1)
APP_PORT=3000
ADMIN_PORT=3001

# ---------------------------------------------------------------- Models
OLLAMA_MODEL=qwen3.5:4b
EMBED_MODEL=nomic-embed-text
# Pin in production, e.g. 0.12.3 (see https://hub.docker.com/r/ollama/ollama/tags)
OLLAMA_VERSION=latest
TTS_ENGINE=kokoro
STT_MODEL=base.en

# ---------------------------------------------------------------- Backups
# Nightly pg_dump into BACKUP_DIR on the host; older dumps are deleted.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- Production only
# Public HTTPS via the Tailscale container (`--profile public`).
# Create a reusable, tagged auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=hello-crew
# Released images: ghcr.io/<GHCR_OWNER>/hello-crew-*:<RELEASE_TAG>
GHCR_OWNER=
RELEASE_TAG=latest
